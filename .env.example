# Local-only template. Do not put real credentials in committed files.

# Production WordPress SSH/WP-CLI helpers.
PUG_PROD_SSH_HOST=example-hostname.com
PUG_PROD_SSH_USER=replace_with_secure_value
PUG_PROD_SSH_PASSWORD=replace_with_secure_value
PUG_PROD_CONFIRM_INSTALL=install-to-production
PUG_PROD_CONFIRM_SCRYDEX_CONFIG=configure-production-scrydex
PUG_PROD_CONFIRM_SCRYDEX_INDEX=run-production-scrydex-index

# ScryDex provider credentials.
SCRYDEX_TEAM_ID=replace_with_secure_value
SCRYDEX_API_KEY=replace_with_secure_value
SCRYDEX_SECONDARY_API_KEY=replace_with_secure_value
SCRYDEX_BASE_URL=https://api.scrydex.com
SCRYDEX_ENVIRONMENT=production
SCRYDEX_VISION_API_KEY=replace_with_secure_value
SCRYDEX_VISION_TEAM_ID=replace_with_secure_value
SCRYDEX_VISION_BASE_URL=https://api.scrydex.com
SCRYDEX_VISION_TIMEOUT_MS=15000

# Read-only live smoke.
SCRYDEX_SMOKE_CONFIRM=pull-live-scrydex
SCRYDEX_SMOKE_QUERY=Charizard
SCRYDEX_SMOKE_PAGE_SIZE=2

# Bounded production catalog indexing.
SCRYDEX_INDEX_GAME=pokemon
SCRYDEX_INDEX_PAGE_SIZE=100
SCRYDEX_INDEX_MAX_PAGES=10
SCRYDEX_INDEX_ROUNDS=1
SCRYDEX_INDEX_EXPANSIONS=true
SCRYDEX_INDEX_EXPANSIONS_PAGE=1
SCRYDEX_INDEX_MAX_EXPANSION_PAGES=25
SCRYDEX_INDEX_BY_SET=true
SCRYDEX_INDEX_SET_LIMIT=5
SCRYDEX_INDEX_SET_OFFSET=0

# Read-only production catalog verification after plugin upload/indexing.
PUG_PROD_EXPECT_PLUGIN_VERSION=
SCRYDEX_VERIFY_MIN_CARDS=1
SCRYDEX_VERIFY_MIN_IMAGE_COVERAGE=1
SCRYDEX_VERIFY_MIN_VARIANT_COVERAGE=1
SCRYDEX_VERIFY_MIN_PRICE_COVERAGE=1
SCRYDEX_VERIFY_MIN_PRICE_POINTS=1

# Local sync WordPress connector. Graded ScryDex price-history lookups can take
# longer than a plain cache read because WordPress may enrich cached cards.
PUG_WORDPRESS_URL=https://example.com
PUG_WORDPRESS_USERNAME=replace_with_application_password_user
PUG_WORDPRESS_APP_PASSWORD=replace_with_application_password
PUG_WORDPRESS_CATALOG_TIMEOUT_MS=30000
PUG_LOCAL_SYNC_WORDPRESS_PUSH_ENABLED=false

# WordPress verifies public ScryDex webhooks; the LAN server polls the
# authenticated relay inbox and performs the actual targeted refresh.
PUG_SCRYDEX_WEBHOOK_RELAY_TOKEN=replace_with_a_long_random_lan_only_value
PUG_SCRYDEX_WEBHOOK_POLL_SECONDS=30
PUG_SCRYDEX_WEBHOOK_POLL_DISABLED=false
PUG_SCRYDEX_DAILY_SYNC_HOUR=4
PUG_SCRYDEX_DAILY_SYNC_CHECK_SECONDS=300
PUG_SCRYDEX_DAILY_SYNC_DISABLED=false

# Optional Square Terminal connector for the in-store LAN server. Keep the real
# token in ignored local env only; the app UI never receives it.
PUG_SQUARE_ENVIRONMENT=sandbox
PUG_SQUARE_ACCESS_TOKEN=replace_with_secure_value
# Optional: leave blank to auto-discover the active Square location from the access token.
PUG_SQUARE_LOCATION_ID=
PUG_SQUARE_TERMINAL_DEVICE_ID=replace_with_secure_value
PUG_SQUARE_API_VERSION=2026-05-20
PUG_SQUARE_INVENTORY_POLL_SECONDS=15
PUG_SQUARE_INVENTORY_POLL_DISABLED=false
