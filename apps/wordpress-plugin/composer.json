{
  "name": "pug-card-shop/tcg-store-platform",
  "description": "Serialized trading-card inventory and store operations for WooCommerce.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "TCGStorePlatform\\": "src/"
    }
  },
  "scripts": {
    "lint": "@php tests/lint.php",
    "test": [
      "@php tests/run.php",
      "@php tests/bootstrap-smoke.php"
    ],
    "standards": "phpcs --standard=phpcs.xml.dist"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
