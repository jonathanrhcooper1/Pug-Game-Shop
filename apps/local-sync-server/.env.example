LOCAL_SYNC_HOST=0.0.0.0
LOCAL_SYNC_PORT=8787
LOCAL_SYNC_SERVER_URL=http://STORE-SERVER-IP:8787
LOCAL_SYNC_SQLITE_PATH=apps/local-sync-server/store-sync.sqlite
LOCAL_SYNC_ALLOW_DEMO_REFERENCE_CARDS=false

# Public WordPress site URL. Credentials stay server-side and are optional.
PUG_WORDPRESS_URL=https://example-store.com
PUG_WORDPRESS_REST_BASE=/wp-json/tcg-store/v1

# Optional WordPress Application Password credentials. These enable server-side
# catalog lookup and inventory pull. They are never returned to local clients.
PUG_WORDPRESS_USERNAME=replace_with_secure_value
PUG_WORDPRESS_APP_PASSWORD=replace_with_secure_value
PUG_WORDPRESS_DEFAULT_LOCATION_ID=replace_with_secure_value

# Push writes to WordPress only when this explicit guard is enabled.
LOCAL_SYNC_WORDPRESS_PUSH_ENABLED=false

# Optional default visibility for inventory accepted into WordPress. Staff can
# override these per intake item from the local app.
PUG_WORDPRESS_INVENTORY_ONLINE_VISIBILITY=visible
PUG_WORDPRESS_INVENTORY_KIOSK_VISIBILITY=visible
PUG_WORDPRESS_INVENTORY_POS_VISIBILITY=visible

# Optional ScryDex Vision live card scanner. Keep these on the LAN server only;
# local clients send camera frames to the LAN server and never receive secrets.
SCRYDEX_VISION_API_KEY=replace_with_secure_value
SCRYDEX_VISION_TEAM_ID=replace_with_secure_value
SCRYDEX_VISION_BASE_URL=https://api.scrydex.com
SCRYDEX_VISION_TIMEOUT_MS=15000

# Optional sandbox/test Square POS inventory-read planning context. This is
# used for manager diagnostics only; the local server never captures payments.
PUG_SQUARE_ENVIRONMENT=sandbox
PUG_SQUARE_ACCESS_TOKEN=replace_with_secure_value
# Optional: leave blank to auto-discover the active Square location from the access token.
PUG_SQUARE_LOCATION_ID=
PUG_SQUARE_API_VERSION=2026-05-20
PUG_SQUARE_INVENTORY_POLL_SECONDS=15
PUG_SQUARE_INVENTORY_POLL_DISABLED=false
PUG_SQUARE_REPORT_LOOKBACK_DAYS=7
